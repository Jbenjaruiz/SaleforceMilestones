{
  "name": "seguimiento-salesforce",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @seguimiento/api\" \"npm run dev -w @seguimiento/web\"",
    "dev:web": "npm run dev -w @seguimiento/web",
    "dev:api": "npm run dev -w @seguimiento/api",
    "build": "npm run build --workspaces",
    "test": "npm test --workspaces",
    "build:import-template": "node scripts/build-import-template.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=24"
  }
}
