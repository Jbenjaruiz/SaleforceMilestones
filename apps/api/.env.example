# Copia este archivo a `.env` (en esta misma carpeta) y completa los valores.
#   cp apps/api/.env.example apps/api/.env
# `.env` está en .gitignore: NUNCA lo subas al repositorio ni pegues sus valores en un chat.

# ── Base de datos SQL Server (obligatorio) ──────────────────────────────────
DB_HOST=                      # servidor o IP, p. ej. sql-pruebas.miempresa.com
DB_PORT=1433
DB_NAME=                      # base de pruebas exclusiva
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=true               # cifrar la conexión (recomendado)
DB_TRUST_SERVER_CERTIFICATE=false   # true solo si el servidor usa un certificado propio/autofirmado

# ── API ─────────────────────────────────────────────────────────────────────
PORT=3000

# ── Autenticación ───────────────────────────────────────────────────────────
JWT_SECRET=                   # obligatorio, mínimo 32 caracteres aleatorios
JWT_EXPIRES_IN=8h

# Usuario administrador inicial que crea `npm run seed`
ADMIN_EMAIL=
ADMIN_PASSWORD=               # mínimo 7 caracteres

# Se usará en pasos siguientes (aún no se lee)
# Carpeta en disco para los adjuntos (paso 6), fuera de lo que sirve el frontend
STORAGE_DIR=./storage/attachments

# Número de proxies de confianza delante de la API (1 si hay IIS o Nginx; vacío en desarrollo).
# Sin esto, detrás de un proxy todos los usuarios comparten IP y el límite de intentos de login los bloquea juntos.
TRUST_PROXY=

# Zona horaria de negocio: define qué es «hoy» al calcular retrasos y al marcar tareas (nombre IANA)
APP_TIMEZONE=America/Guatemala
